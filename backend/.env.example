# DEVELOPMENT ONLY. Do not use this file for production.
# Copy values into backend/.env only for local development.

DATABASE_URL=sqlite:///./tuda_suda.db
TELEGRAM_BOT_TOKEN=
APP_ENV=development
AUTO_INIT_DB=true
ALLOW_MOCK_AUTH=false
AUTH_TOKEN_SECRET=<development_auth_secret_32_plus_chars>
AUTH_TOKEN_TTL_HOURS=24
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
ADMIN_API_KEY=<development_admin_token>

INITIAL_BALANCE=100
DAILY_SEND_LIMIT=20
GIFT_FEE_BPS=0
PURCHASE_FEE_PERCENT=1
BUY_COMMISSION_PERCENT=1
TDSD_FIXED_PRICE_TON=0.1
TRANSFER_COMMISSION_PERCENT=10
TREASURY_USER_ID=

TREASURY_WALLET_ADDRESS=<treasury_wallet_public_address>
HOT_WALLET_ADDRESS=<hot_wallet_public_address>
HOT_WALLET_MNEMONIC=
HOT_WALLET_JETTON_TRANSFER_GAS_TON=0.08

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
APP_VERSION=0.8.0

TON_NETWORK=testnet
# Deprecated: use HOT_WALLET_ADDRESS instead.
# PROJECT_TON_WALLET=
TONCENTER_API_URL=https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
TONCENTER_TX_LIMIT=100
MIN_DEPOSIT_TON=0.05
MAX_DEPOSIT_TON=5
DEPOSIT_CONFIRMATION_TIMEOUT_MINUTES=30

SEED_TDSD_ASSET=true
TDSD_ASSET_SYMBOL=TDSD
TDSD_ASSET_NAME=Tuda Suda Token
TDSD_DECIMALS=9
TDSD_NETWORK=ton_testnet
TDSD_JETTON_MASTER_ADDRESS=<tdsd_jetton_master_address>
TDSD_PROJECT_JETTON_WALLET=
TDSD_DEPOSITS_ENABLED=false

REFERRALS_ENABLED=true
REFERRAL_REWARD_PERCENT=10
REFERRAL_REWARD_ASSET_SYMBOL=TDSD
TELEGRAM_BOT_USERNAME=tudasuda_tdsd_bot
TELEGRAM_MINI_APP_SHORT_NAME=
FRONTEND_URL=http://localhost:5173
