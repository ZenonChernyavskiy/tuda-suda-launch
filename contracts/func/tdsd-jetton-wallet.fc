;; TDSD Jetton Wallet contract source template.
;;
;; Stores a single owner's balance and supports transfer, internal_transfer,
;; burn, and excess notification flow according to the Jetton wallet shape.
;; Compile, test, and audit before public deployment.

#include "stdlib.fc";

const int op_transfer = 0x0f8a7ea5;
const int op_internal_transfer = 0x178d4519;
const int op_transfer_notification = 0x7362d09c;
const int op_burn = 0x595f07bc;
const int op_burn_notification = 0x7bdd97de;
const int op_excesses = 0xd53276db;

(int, slice, slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int balance = ds~load_coins();
    slice owner_address = ds~load_msg_addr();
    slice master_address = ds~load_msg_addr();
    cell wallet_code = ds~load_ref();
    return (balance, owner_address, master_address, wallet_code);
}

() save_data(int balance, slice owner_address, slice master_address, cell wallet_code) impure inline {
    set_data(
        begin_cell()
            .store_coins(balance)
            .store_slice(owner_address)
            .store_slice(master_address)
            .store_ref(wallet_code)
        .end_cell()
    );
}

cell calculate_wallet_state_init(slice owner_address, slice master_address, cell wallet_code) inline {
    cell data = begin_cell()
        .store_coins(0)
        .store_slice(owner_address)
        .store_slice(master_address)
        .store_ref(wallet_code)
    .end_cell();
    return begin_cell()
        .store_uint(0, 2)
        .store_dict(wallet_code)
        .store_dict(data)
        .store_uint(0, 1)
    .end_cell();
}

slice calculate_wallet_address(slice owner_address, slice master_address, cell wallet_code) inline {
    cell state_init = calculate_wallet_state_init(owner_address, master_address, wallet_code);
    return begin_cell()
        .store_uint(4, 3)
        .store_int(workchain(), 8)
        .store_uint(cell_hash(state_init), 256)
    .end_cell()
    .begin_parse();
}

() send_tokens(
    slice destination_owner,
    int jetton_amount,
    slice response_destination,
    int forward_ton_amount,
    cell forward_payload,
    int query_id
) impure {
    (int balance, slice owner_address, slice master_address, cell wallet_code) = load_data();
    throw_unless(705, balance >= jetton_amount);
    balance -= jetton_amount;
    save_data(balance, owner_address, master_address, wallet_code);

    slice destination_wallet = calculate_wallet_address(destination_owner, master_address, wallet_code);
    cell state_init = calculate_wallet_state_init(destination_owner, master_address, wallet_code);
    cell body = begin_cell()
        .store_uint(op_internal_transfer, 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(owner_address)
        .store_slice(response_destination)
        .store_coins(forward_ton_amount)
        .store_ref(forward_payload)
    .end_cell();

    send_raw_message(
        begin_cell()
            .store_uint(0x18, 6)
            .store_slice(destination_wallet)
            .store_coins(forward_ton_amount + 50000000)
            .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
            .store_ref(state_init)
            .store_ref(body)
        .end_cell(),
        1
    );
}

() receive_tokens(slice sender_address, slice in_msg_body) impure {
    int query_id = in_msg_body~load_uint(64);
    int jetton_amount = in_msg_body~load_coins();
    slice from_address = in_msg_body~load_msg_addr();
    slice response_destination = in_msg_body~load_msg_addr();
    int forward_ton_amount = in_msg_body~load_coins();

    (int balance, slice owner_address, slice master_address, cell wallet_code) = load_data();
    slice expected_wallet = calculate_wallet_address(from_address, master_address, wallet_code);
    throw_unless(706, equal_slices(sender_address, master_address) | equal_slices(sender_address, expected_wallet));
    balance += jetton_amount;
    save_data(balance, owner_address, master_address, wallet_code);

    if (forward_ton_amount > 0) {
        cell notification_body = begin_cell()
            .store_uint(op_transfer_notification, 32)
            .store_uint(query_id, 64)
            .store_coins(jetton_amount)
            .store_slice(from_address)
            .store_slice(in_msg_body)
        .end_cell();
        send_raw_message(
            begin_cell()
                .store_uint(0x10, 6)
                .store_slice(owner_address)
                .store_coins(forward_ton_amount)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(notification_body)
            .end_cell(),
            1
        );
    }

    if (response_destination.preload_uint(2) != 0) {
        cell excess_body = begin_cell()
            .store_uint(op_excesses, 32)
            .store_uint(query_id, 64)
        .end_cell();
        send_raw_message(
            begin_cell()
                .store_uint(0x10, 6)
                .store_slice(response_destination)
                .store_coins(0)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(excess_body)
            .end_cell(),
            64
        );
    }
}

() burn_tokens(slice sender_address, slice in_msg_body) impure {
    int query_id = in_msg_body~load_uint(64);
    int jetton_amount = in_msg_body~load_coins();
    slice response_destination = in_msg_body~load_msg_addr();

    (int balance, slice owner_address, slice master_address, cell wallet_code) = load_data();
    throw_unless(707, equal_slices(sender_address, owner_address));
    throw_unless(708, balance >= jetton_amount);
    balance -= jetton_amount;
    save_data(balance, owner_address, master_address, wallet_code);

    cell body = begin_cell()
        .store_uint(op_burn_notification, 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(owner_address)
        .store_slice(response_destination)
    .end_cell();

    send_raw_message(
        begin_cell()
            .store_uint(0x10, 6)
            .store_slice(master_address)
            .store_coins(50000000)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(body)
        .end_cell(),
        1
    );
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);

    if (op == op_transfer) {
        int query_id = in_msg_body~load_uint(64);
        int jetton_amount = in_msg_body~load_coins();
        slice destination_owner = in_msg_body~load_msg_addr();
        slice response_destination = in_msg_body~load_msg_addr();
        in_msg_body~load_maybe_ref(); ;; custom_payload
        int forward_ton_amount = in_msg_body~load_coins();
        cell forward_payload = in_msg_body~load_ref();
        (int balance, slice owner_address, slice master_address, cell wallet_code) = load_data();
        throw_unless(709, equal_slices(sender_address, owner_address));
        send_tokens(destination_owner, jetton_amount, response_destination, forward_ton_amount, forward_payload, query_id);
        return ();
    }

    if (op == op_internal_transfer) {
        receive_tokens(sender_address, in_msg_body);
        return ();
    }

    if (op == op_burn) {
        burn_tokens(sender_address, in_msg_body);
        return ();
    }

    throw(0xffff);
}

(int, slice, slice, cell) get_wallet_data() method_id {
    return load_data();
}
