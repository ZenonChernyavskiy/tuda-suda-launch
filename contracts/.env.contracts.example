TON_NETWORK=testnet
TONCENTER_API_KEY=

# Public addresses only. Never put seed phrases, mnemonics or private keys here.
TDSD_OWNER_ADDRESS=
TDSD_PROJECT_WALLET_ADDRESS=
TDSD_JETTON_MASTER_ADDRESS=
TDSD_PROJECT_JETTON_WALLET=

TDSD_SYMBOL=TDSD
TDSD_NAME=Tuda Suda Token
TDSD_DECIMALS=9
TDSD_METADATA_URL=https://app.example.com/tdsd-metadata.json

# Mint script.
# 1 TDSD = 1000000000 units when decimals=9.
TDSD_MINT_RECIPIENT=
TDSD_MINT_AMOUNT_UNITS=100000000000

# Transfer script.
TDSD_TRANSFER_SENDER_OWNER=
TDSD_TRANSFER_DESTINATION_OWNER=
TDSD_TRANSFER_AMOUNT_UNITS=1000000000
TDSD_TRANSFER_MEMO=Tuda Suda test transfer

# Burn script.
TDSD_BURN_OWNER=
TDSD_BURN_AMOUNT_UNITS=1000000000

# Getter script.
TDSD_WALLET_OWNER=
