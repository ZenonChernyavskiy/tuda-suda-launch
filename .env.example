DATABASE_URL=postgresql+psycopg://tuda_suda:<postgres_password>@postgres:5432/tuda_suda
APP_ENV=production
AUTO_INIT_DB=true
ALLOW_MOCK_AUTH=false
AUTH_TOKEN_SECRET=<random_32_plus_char_secret>
AUTH_TOKEN_TTL_HOURS=24
ADMIN_API_KEY=<random_admin_token>
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_BOT_USERNAME=tudasuda_tdsd_bot
TELEGRAM_MINI_APP_SHORT_NAME=

CORS_ORIGINS=https://app.tudasuda.tech
PUBLIC_APP_URL=https://app.tudasuda.tech
PUBLIC_API_URL=https://api.tudasuda.tech
FRONTEND_URL=https://app.tudasuda.tech
VITE_API_URL=https://api.tudasuda.tech
VITE_APP_URL=https://app.tudasuda.tech
VITE_TONCONNECT_MANIFEST_URL=https://app.tudasuda.tech/tonconnect-manifest.json
VITE_ENABLE_MOCK_AUTH=false

PURCHASE_FEE_PERCENT=1
BUY_COMMISSION_PERCENT=1
TRANSFER_COMMISSION_PERCENT=10
TDSD_FIXED_PRICE_TON=0.1

HOT_WALLET_ADDRESS=<hot_wallet_public_address>
HOT_WALLET_MNEMONIC=<hot wallet mnemonic words>
HOT_WALLET_JETTON_TRANSFER_GAS_TON=0.08
TREASURY_WALLET_ADDRESS=<treasury_wallet_public_address>
# Deprecated: use HOT_WALLET_ADDRESS instead.
# PROJECT_TON_WALLET=
TON_NETWORK=testnet
TONCENTER_API_URL=https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
TONCENTER_TX_LIMIT=100

SEED_TDSD_ASSET=true
TDSD_ASSET_SYMBOL=TDSD
TDSD_ASSET_NAME=Tuda Suda Token
TDSD_DECIMALS=9
TDSD_NETWORK=ton_testnet
TDSD_JETTON_MASTER_ADDRESS=<tdsd_jetton_master_address>
TDSD_PROJECT_JETTON_WALLET=
TDSD_DEPOSITS_ENABLED=false

REFERRALS_ENABLED=true
REFERRAL_REWARD_PERCENT=10
REFERRAL_REWARD_ASSET_SYMBOL=TDSD

POSTGRES_DB=tuda_suda
POSTGRES_USER=tuda_suda
POSTGRES_PASSWORD=<postgres_password>
